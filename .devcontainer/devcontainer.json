{
  "name": "Cyberweerbaarheid Monitor",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  // Afhankelijkheden installeren zodra de Codespace is aangemaakt
  "postCreateCommand": "pip install --user -r requirements.txt",

  // De app automatisch starten wanneer je de Codespace opent
  "postAttachCommand": "python run.py",

  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Cyberweerbaarheid Monitor",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
