# Kopieer naar .env of zet deze variabelen in je omgeving.

# PostgreSQL (optioneel). Als deze niet is ingesteld of niet bereikbaar is,
# gebruikt de app automatisch SQLite (instance/cyber.db).
# DATABASE_URL=postgresql://gebruiker:wachtwoord@localhost:5432/cyber

# Pad naar het SQLite-bestand (optioneel)
# SQLITE_PATH=instance/cyber.db

# Geheime sleutel voor sessies (wordt anders automatisch gegenereerd in instance/secret_key)
# SECRET_KEY=verander-mij

# Naam in de kopbalk
# APP_NAAM=Cyberweerbaarheid Monitor
